# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# ============================================================
# RAG pipeline (src/, dashboard/) -- see README.md
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\the\key.json
# GOOGLE_CALENDAR_ID=the-calendar's-id@group.calendar.google.com
# GOOGLE_SHEET_ID=the-spreadsheet-id-from-its-url

# ============================================================
# api/ backend -- Partie 1.1 multi-tenant authentication
# ============================================================

# -- Database ------------------------------------------------
# Must use the asyncpg driver (postgresql+asyncpg://, not postgresql://)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_saas

# -- JWT / cookies / sessions ---------------------------------
# Generate both with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
SESSION_MIDDLEWARE_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_TOKEN_EXPIRE_MINUTES=5
COOKIE_SECURE=True
# COOKIE_DOMAIN=.yourapp.com

# -- Password reset / email OTP --------------------------------
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# -- 2FA lockout recovery (lost device AND all recovery codes) --
# TWO_FA_LOCKOUT_RECOVERY_DELAY_HOURS is the mandatory wait before a
# requested 2FA removal can be confirmed -- see api/config.py's comment.
TWO_FA_LOCKOUT_RECOVERY_DELAY_HOURS=24
TWO_FA_LOCKOUT_RECOVERY_TOKEN_EXPIRE_HOURS=96

# -- RGPD -------------------------------------------------------
TERMS_VERSION=2026-01-01
ACCOUNT_PURGE_DELAY_DAYS=30
# Longer than PASSWORD_RESET_TOKEN_EXPIRE_MINUTES on purpose -- see
# api/config.py's comment: undoing a deletion is lower-urgency than a
# password reset, and the user has up to ACCOUNT_PURGE_DELAY_DAYS to
# even notice the email.
ACCOUNT_RESTORE_TOKEN_EXPIRE_MINUTES=1440

# -- Frontend / CORS ----------------------------------------------
FRONTEND_URL=http://localhost:3000

# -- OAuth (1.1.5 / 1.1.6) -- leave a provider's pair unset to disable it --
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# -- Transactional email (Resend) -- https://resend.com/api-keys --
RESEND_API_KEY=re_...
# Until your own domain shows "Verified" under resend.com/domains, Resend's
# sandbox sender only delivers to the account owner's own email -- fine for
# dev, switch to no-reply@yourdomain once the domain is verified.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# -- Object storage (S3-compatible) -- 1.1.13 avatar upload --
# Any S3-compatible bucket works: real AWS S3 (leave S3_ENDPOINT_URL
# unset), Cloudflare R2 (needs a payment method on file even on the free
# tier), or Supabase Storage's S3 API (no card needed, reuses the same
# Supabase project as DATABASE_URL -- Project > Storage > create a bucket
# dedicated to avatars > Configuration > S3 > New access key).
# IMPORTANT: S3_BUCKET_NAME must be a bucket dedicated to avatars -- the
# object key has no "avatars/" prefix of its own (see api/services/
# storage.py), so a shared multi-purpose bucket would need its own prefix
# added back in to avoid colliding with other uploads.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://cdn.yourapp.com

# -- Celery (1.1.10's account-purge sweep) -------------------------
# Needs a real Redis reachable at these URLs. On Windows with no Docker/
# admin rights: `winget install taizod1024.redis-windows-fork`, then run
# the extracted redis-server.exe directly (no service install needed).
# Elsewhere: `docker run -p 6379:6379 redis` or any managed Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Worker:  python -m celery -A api.tasks.celery_app worker --loglevel=info --pool=solo
#          (--pool=solo is required on Windows; drop it elsewhere)
# Beat:    python -m celery -A api.tasks.celery_app beat --loglevel=info

# -- Rate limiting (brute-force / spam protection) ---------------------
# Same Redis server as Celery above works fine -- just a different DB
# number so the two never share keys. Set RATE_LIMIT_ENABLED=False only
# for local dev without Redis; never in a real deployment (see
# api/security/rate_limit.py's docstring for the fail-open design and why
# that's still safer than the alternative).
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_FORGOT_RATE_LIMIT_MAX_ATTEMPTS=3
PASSWORD_FORGOT_RATE_LIMIT_WINDOW_SECONDS=3600
EMAIL_VERIFY_REQUEST_RATE_LIMIT_MAX_ATTEMPTS=3
EMAIL_VERIFY_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
TWO_FA_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=5
TWO_FA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=900
# Also reused, under their own Redis key namespaces, for
# /auth/2fa/verify-recovery-code and /auth/2fa/{enable,disable,recovery-codes/regenerate}
# -- see docs/AUTH_BACKEND_SETUP.md's rate limiting table.
ACCOUNT_RESTORE_RATE_LIMIT_MAX_ATTEMPTS=3
ACCOUNT_RESTORE_RATE_LIMIT_WINDOW_SECONDS=3600
