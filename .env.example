# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# ============================================================
# RAG pipeline (src/, dashboard/) -- see README.md
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\the\key.json
# GOOGLE_CALENDAR_ID=the-calendar's-id@group.calendar.google.com
# GOOGLE_SHEET_ID=the-spreadsheet-id-from-its-url

# ============================================================
# api/ backend -- Partie 1.1 multi-tenant authentication
# ============================================================

# -- Database ------------------------------------------------
# Must use the asyncpg driver (postgresql+asyncpg://, not postgresql://)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_saas

# -- JWT / cookies / sessions ---------------------------------
# Generate all three with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
SESSION_MIDDLEWARE_SECRET=
# Signs the audit log's tamper-evidence hash chain -- api/security/audit_log.py.
# Deliberately separate from the two keys above (key separation): rotating
# either of those must never retroactively change what a past audit row's
# checksum was computed with.
AUDIT_LOG_HMAC_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_TOKEN_EXPIRE_MINUTES=5
# Comma-separated PREVIOUS JWT_SECRET_KEY values, still accepted when
# verifying (never for signing new tokens) -- leave empty normally. See
# docs/AUTH_BACKEND_SETUP.md's "JWT key rotation" section for the two
# very different procedures this supports (routine rotation vs.
# responding to a leak -- do NOT put a leaked key here).
JWT_PREVIOUS_SECRET_KEYS=
COOKIE_SECURE=True
# COOKIE_DOMAIN=.yourapp.com

# -- Password reset / email OTP --------------------------------
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# -- 2FA lockout recovery (lost device AND all recovery codes) --
# TWO_FA_LOCKOUT_RECOVERY_DELAY_HOURS is the mandatory wait before a
# requested 2FA removal can be confirmed -- see api/config.py's comment.
TWO_FA_LOCKOUT_RECOVERY_DELAY_HOURS=24
TWO_FA_LOCKOUT_RECOVERY_TOKEN_EXPIRE_HOURS=96

# -- Session lifecycle (audit Categorie 1, items 13/14/17) --------
# A session idle this long is revoked on its next use (its access
# token blacklisted too) -- see api/security/sessions.py's
# touch_session_and_check_idle_timeout.
SESSION_IDLE_TIMEOUT_MINUTES=30
# How many devices/browsers an account may have signed in at once --
# the oldest is signed out to make room for a new sign-in past this.
MAX_CONCURRENT_SESSIONS=5

# -- Password policy (audit Categorie 1, items 15/16) --------------
# How many of a user's most recent passwords a new one is checked
# against, in addition to the current one -- api/models/password_history.py.
PASSWORD_HISTORY_SIZE=5
# A new password within this many single-character edits of the
# account's email or name is rejected -- api/security/password_similarity.py.
PASSWORD_SIMILARITY_MIN_DISTANCE=3

# -- RGPD -------------------------------------------------------
# Bump this whenever the actual terms of service change -- every
# account that consented under an older value gets blocked (403) from
# ordinary use until it re-consents via
# POST /account/consent/accept-updated-terms. See api/dependencies.py's
# get_current_user.
TERMS_VERSION=2026-01-01
ACCOUNT_PURGE_DELAY_DAYS=30
# Longer than PASSWORD_RESET_TOKEN_EXPIRE_MINUTES on purpose -- see
# api/config.py's comment: undoing a deletion is lower-urgency than a
# password reset, and the user has up to ACCOUNT_PURGE_DELAY_DAYS to
# even notice the email.
ACCOUNT_RESTORE_TOKEN_EXPIRE_MINUTES=1440
# How close to the actual purge the "last chance" reminder email goes
# out -- separate from the immediate confirmation DELETE /account/me
# already sends. See api/tasks/account_deletion_reminder.py.
ACCOUNT_DELETION_REMINDER_DAYS_BEFORE=3

# -- Frontend / CORS ----------------------------------------------
FRONTEND_URL=http://localhost:3000

# -- OAuth (1.1.5 / 1.1.6) -- leave a provider's pair unset to disable it --
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# -- Transactional email (Resend) -- https://resend.com/api-keys --
RESEND_API_KEY=re_...
# Until your own domain shows "Verified" under resend.com/domains, Resend's
# sandbox sender only delivers to the account owner's own email -- fine for
# dev, switch to no-reply@yourdomain once the domain is verified.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# RGPD Art. 12: a data subject must be able to easily reach the controller
# to exercise their rights or ask questions. Required -- api/services/
# email.py's _send() appends it as a contact footer to every email this
# app sends. Must be a real, monitored inbox before going live.
SUPPORT_EMAIL=support@yourapp.com

# -- Object storage (S3-compatible) -- 1.1.13 avatar upload --
# Any S3-compatible bucket works: real AWS S3 (leave S3_ENDPOINT_URL
# unset), Cloudflare R2 (needs a payment method on file even on the free
# tier), or Supabase Storage's S3 API (no card needed, reuses the same
# Supabase project as DATABASE_URL -- Project > Storage > create a bucket
# dedicated to avatars > Configuration > S3 > New access key).
# IMPORTANT: S3_BUCKET_NAME must be a bucket dedicated to avatars -- the
# object key has no "avatars/" prefix of its own (see api/services/
# storage.py), so a shared multi-purpose bucket would need its own prefix
# added back in to avoid colliding with other uploads.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://cdn.yourapp.com

# -- Document uploads (Partie 2.1.1) --
# A SEPARATE bucket from S3_BUCKET_NAME above -- documents are private
# organizational content, uploaded with no public ACL, unlike the
# public-by-design avatar/logo/favicon assets that bucket holds. Same
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/S3_ENDPOINT_URL/S3_REGION
# credentials above, just a different bucket name -- this one must NOT
# have a public-read bucket policy.
S3_DOCUMENTS_BUCKET_NAME=

# -- GitHub repository import (Partie 2.1.12) --
# Optional: a PUBLIC repo can be imported with none of this set at all
# (GitHub's REST API allows unauthenticated reads, just at a much lower
# real rate limit -- 60 requests/hour instead of 5,000/hour). A PRIVATE
# repo genuinely cannot be imported without a real token.
#
# To create one: GitHub -> Settings -> Developer settings -> Personal
# access tokens -> Fine-grained tokens -> Generate new token. Grant it
# read-only "Contents" and "Metadata" repository permissions, scoped to
# only the repositories this server should be able to import from (never
# grant it access to every repository you own). A classic token with the
# `repo` scope also works, but a fine-grained, read-only, repo-scoped one
# is the safer choice for a server-side integration like this.
#
# This is NOT the same thing as GITHUB_OAUTH_CLIENT_ID/SECRET above --
# those authenticate a USER signing into this app WITH GitHub; this one
# authenticates THIS SERVER's own calls to GitHub's API.
GITHUB_API_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_FILE_SIZE=1048576
GITHUB_INCLUDE_PATTERNS=.md,.txt,.py,.js,.ts,.json,.yml,.yaml

# -- Google Drive import (Partie 2.1.14) --
# Required together for ANY real Drive import to work -- unlike
# GITHUB_API_TOKEN above, Drive has no unauthenticated read mode at all.
#
# To create these: Google Cloud Console -> APIs & Services -> Credentials
# -> Create OAuth client ID (Desktop app type is simplest for this kind
# of server-side, non-interactive use) -> note the client ID/secret
# below. Enable the "Google Drive API" for that project first
# (APIs & Services -> Library). Then obtain a REAL refresh token ONCE,
# out of band (this app has no interactive "connect your Drive" flow --
# GOOGLE_OAUTH_CLIENT_ID/SECRET above are for a DIFFERENT feature, a
# user signing into this app WITH Google): the simplest path is
# Google's own OAuth 2.0 Playground (https://developers.google.com/oauthplayground),
# using your own client ID/secret (gear icon -> "Use your own OAuth
# credentials"), authorizing the `https://www.googleapis.com/auth/drive.readonly`
# scope, and exchanging the resulting authorization code for tokens --
# the real REFRESH token from that exchange goes below. Scope this to a
# real Google account/Shared Drive you control, not a personal account
# with unrelated sensitive files, since this server can read anything
# that account's Drive can see.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_MAX_FILE_SIZE=52428800
GOOGLE_DRIVE_INCLUDE_PATTERNS=.pdf,.docx,.txt,.md,.html,.csv,.json,.xml,.epub

# -- Google Docs/Sheets/Slides import (Partie 2.1.15) --
# Reuses GOOGLE_DRIVE_CLIENT_ID/SECRET/REFRESH_TOKEN above -- no separate
# credentials needed, a real Google Doc is just a real Drive file.
GOOGLE_DOCS_EXPORT_FORMAT=application/vnd.openxmlformats-officedocument.wordprocessingml.document

# -- Notion import (Partie 2.1.16) --
# A real Notion "internal integration" token: notion.so -> Settings ->
# Connections -> Develop or manage integrations -> New integration
# (Internal). The page/database you want to import must ALSO be
# explicitly shared with this integration inside Notion itself (the
# "..." menu on a page -> Connections -> add your integration) --
# Notion's own API cannot see anything not explicitly shared with it.
NOTION_API_TOKEN=
NOTION_MAX_BLOCKS=1000
NOTION_INCLUDE_TYPES=paragraph,heading_1,heading_2,heading_3,bulleted_list_item,numbered_list_item,to_do,quote,code,toggle,divider

# -- Celery (1.1.10's account-purge sweep) -------------------------
# Needs a real Redis reachable at these URLs. On Windows with no Docker/
# admin rights: `winget install taizod1024.redis-windows-fork`, then run
# the extracted redis-server.exe directly (no service install needed).
# Elsewhere: `docker run -p 6379:6379 redis` or any managed Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Worker:  python -m celery -A api.tasks.celery_app worker --loglevel=info --pool=solo
#          (--pool=solo is required on Windows; drop it elsewhere)
# Beat:    python -m celery -A api.tasks.celery_app beat --loglevel=info

# -- Rate limiting (brute-force / spam protection) ---------------------
# Same Redis server as Celery above works fine -- just a different DB
# number so the two never share keys. Set RATE_LIMIT_ENABLED=False only
# for local dev without Redis; never in a real deployment (see
# api/security/rate_limit.py's docstring for the fail-open design and why
# that's still safer than the alternative).
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_FORGOT_RATE_LIMIT_MAX_ATTEMPTS=3
PASSWORD_FORGOT_RATE_LIMIT_WINDOW_SECONDS=3600
EMAIL_VERIFY_REQUEST_RATE_LIMIT_MAX_ATTEMPTS=3
EMAIL_VERIFY_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
TWO_FA_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=5
TWO_FA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=900
# Also reused, under their own Redis key namespaces, for
# /auth/2fa/verify-recovery-code and /auth/2fa/{enable,disable,recovery-codes/regenerate}
# -- see docs/AUTH_BACKEND_SETUP.md's rate limiting table.
ACCOUNT_RESTORE_RATE_LIMIT_MAX_ATTEMPTS=3
ACCOUNT_RESTORE_RATE_LIMIT_WINDOW_SECONDS=3600

# -- Session lifecycle (audit Categorie 1, items 13/14/17) ---------
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

# -- Password policy (audit Categorie 1, items 15/16) ---------------
PASSWORD_HISTORY_SIZE=5
PASSWORD_SIMILARITY_MIN_DISTANCE=3

# -- Security alerts (audit Categorie 2, item 21) --------------------
# Leave both unset to disable real-time alerting entirely; either or
# both may be set -- see api/services/security_alerts.py.
# SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SECURITY_ALERT_EMAIL=security-team@yourapp.com
SECURITY_ALERT_FAILED_LOGIN_THRESHOLD=10
SECURITY_ALERT_WINDOW_MINUTES=5

# -- Geo-adaptive rate limiting (audit Categorie 4, item 29) -----------
# Both lists empty (the default) means every caller gets the same flat
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS/REGISTER_RATE_LIMIT_MAX_ATTEMPTS --
# identical behavior to before this feature existed. ISO 3166-1 alpha-2
# codes, comma-separated -- see api/security/geoip.py.
GEO_IP_LOOKUP_ENABLED=True
TRUSTED_COUNTRIES=
SUSPICIOUS_COUNTRIES=
GEO_RATE_LIMIT_TRUSTED_MULTIPLIER=2.0
GEO_RATE_LIMIT_SUSPICIOUS_MULTIPLIER=0.5

# -- Trusted IP / VPN exemption (audit Categorie 4, item 30) -----------
# Comma-separated IPs and/or CIDR ranges fully exempted from rate
# limiting -- e.g. "203.0.113.5,10.8.0.0/24". Empty (the default)
# exempts nothing. See api/security/trusted_ips.py.
TRUSTED_IPS=

# -- Shared encryption-at-rest for DB-stored secrets -------------------
# Required only once JWT_AUTO_ROTATION_INTERVAL_DAYS > 0 (below), an
# enterprise SSO connection is created (Admin > SSO), or an SSL
# certificate/ACME account is stored (Partie 1.4.3). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# -- Automatic JWT key rotation (audit Categorie 4, item 28) -----------
# 0 (the default) disables automatic rotation entirely -- the manual
# JWT_PREVIOUS_SECRET_KEYS mechanism above keeps working unchanged
# either way. See api/tasks/jwt_key_rotation.py.
JWT_AUTO_ROTATION_INTERVAL_DAYS=0

# -- SSL auto -- Let's Encrypt (Partie 1.4.3) ---------------------------
# Required to use any /ssl/* endpoint at all (generate/renew both
# raise a clear error otherwise). Defaults to Let's Encrypt STAGING,
# deliberately -- change to
# "https://acme-v02.api.letsencrypt.org/directory" only once you've
# exercised the manual DNS-01 workflow for real (see
# docs/AUTH_BACKEND_SETUP.md's "SSL auto" section for why issuance and
# every renewal need a human to publish a DNS TXT record).
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCOUNT_EMAIL=
JWT_KEY_RETENTION_DAYS=7
JWT_KEY_CACHE_REFRESH_SECONDS=60
# JWT_KEY_ROTATION_ADMIN_EMAIL=security-team@yourapp.com

# -- WebAuthn / FIDO2 (audit Categorie 4, item 26) ---------------------
# rp_id must be the exact domain (no scheme/port) the frontend is served
# from; rp_origin is the full origin (with scheme) the browser's
# navigator.credentials calls actually run from. See api/security/webauthn.py.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RAG SaaS Platform
WEBAUTHN_RP_ORIGIN=http://localhost:3000
WEBAUTHN_MAX_CREDENTIALS_PER_USER=10

# -- Monitoring (audit finding 22) -----------------------------------
# Only needed when running api/ with MORE THAN ONE worker process in
# production (`gunicorn -c gunicorn.conf.py api.main:app`) -- leave
# unset for local dev (`uvicorn api.main:app --reload`) or a
# single-worker deployment; GET /metrics works correctly either way.
# One directory ALL worker processes must share; gunicorn.conf.py's
# on_starting hook creates it and clears stale files from a previous run.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
# How many worker processes gunicorn.conf.py starts.
WEB_CONCURRENCY=4
