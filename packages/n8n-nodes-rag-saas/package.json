{
  "name": "n8n-nodes-rag-saas",
  "version": "0.1.0",
  "description": "n8n node for RAG SaaS Platform",
  "keywords": [
    "n8n-community-node-package",
    "rag",
    "saas",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/naomytcheums-dotcom/rag-saas-platform",
  "author": {
    "name": "Naomy Tcheums"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naomytcheums-dotcom/rag-saas-platform.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RagSaasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RagSaas/RagSaas.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "^5.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-core": "^1.0.0",
    "n8n-workflow": "^1.0.0",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  },
  "dependencies": {
    "n8n-workflow": "^1.0.0"
  }
}
