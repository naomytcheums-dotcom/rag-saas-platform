NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 5, Étape 15 -- frontend error tracking (api/security/error_tracking.py
# has the backend equivalent since Étape 7). Leave NEXT_PUBLIC_SENTRY_DSN
# empty to keep Sentry a real, inert no-op -- same pattern as the backend's
# own SENTRY_DSN. NEXT_PUBLIC_SENTRY_DSN is a Sentry DSN, meant to be public
# (it authorizes sending events TO a project, nothing more) -- SENTRY_AUTH_TOKEN
# below is the one that must stay secret (it authorizes uploading sourcemaps).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
