# Real peer-dependency conflict, not a Vercel-only fluke: vitest@5/vite@8
# declare an optional peer on @types/node ("^20.19.0 || >=22.12.0") that a
# plain `npm install` resolves strictly against, while this project's own
# @types/node range ("^20") and a few other dev-tooling peers (vitest/
# jest-dom) don't line up closely enough for npm 7+'s default strict
# resolver -- confirmed locally (every install in this project has needed
# --legacy-peer-deps, e.g. when adding next-google-translate-widget) and on
# Vercel (ERESOLVE on a from-scratch `npm install`, no local node_modules to
# fall back on). This is the same relaxed resolution mode as the flag
# already used everywhere locally, just applied automatically so Vercel's
# build (a plain `npm install`, no flag) doesn't hit it.
legacy-peer-deps=true
